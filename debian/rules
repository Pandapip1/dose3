#!/usr/bin/make -f

%:
	dh $@ --with ocaml

override_dh_auto_configure:
	./configure --with-ocamlgraph --with-zip --with-bz2 --with-rpm4

override_dh_auto_install:
	dh_auto_install
	cd debian/tmp/usr/bin \
		&& mv distcheck dose3-distcheck \
		&& mv deb-buildcheck dose3-builddebcheck
# this should be fixed upstream:
	for d in _build/algo/algo.o _build/algo/algo.a; do \
	    if [ -f $$d ]; then cp $$d debian/tmp/usr/lib/ocaml/dose3; fi;\
	done

override_dh_installman:
	dh_installman
	cd debian/dose3-distcheck/usr/share/man/man1 \
		&& mv distcheck.1 dose3-distcheck.1

override_dh_auto_build:
	dh_auto_build
	pod2man --section 8 \
	  --release "apt-cudf $(shell dpkg-parsechangelog | grep ^Version: | cut -f 2 -d' ')" \
	  debian/update-cudf-solvers > debian/update-cudf-solvers.8

override_dh_auto_clean:
	dh_auto_clean
	rm -f debian/update-cudf-solvers.8
	rm -f _tags

