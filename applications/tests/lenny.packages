Depends: libatk1.0-0 (>= 1.20.0), libc6 (>= 2.7-1), libcairo2 (>= 1.2.4), libfontconfig1 (>= 2.4.0), libfreetype6 (>= 2.3.5), libgcc1 (>= 1:4.1.1-21), libglib2.0-0 (>= 2.16.0), libgtk2.0-0 (>= 2.12.0), libgtkextra-x11-2.0-1, libpango1.0-0 (>= 1.20.2), libpixman-1-0, libpng12-0 (>= 1.2.13-4), libpopt0 (>= 1.10), libreadline5 (>= 5.2), libstdc++6 (>= 4.2.1-4), libx11-6, libxcursor1 (>> 1.1.2), libxext6, libxfixes3 (>= 1:4.0.1), libxi6, libxinerama1, libxrandr2, libxrender1, zlib1g (>= 1:1.1.4)
