Depends: libapertium3-3.0-0, libc6 (>= 2.7-1), libgcc1 (>= 1:4.1.1), liblttoolbox3-3.0-0, libpcre3 (>= 7.4), libpcrecpp0 (>= 7.6), libstdc++6 (>= 4.2.1), libxml2 (>= 2.6.27), lttoolbox (>= 3.0.0), libxml2-utils (>= 2.6.24), libpcre3 (<< 7.8)
