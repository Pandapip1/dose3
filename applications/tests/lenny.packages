Package: xfonts-wqy
Priority: optional
Section: x11
Installed-Size: 18948
Maintainer: Cai Qian <caiqian@debian.org>
Architecture: all
Version: 0.9.9-3.1
Depends: debconf (>= 0.5) | debconf-2.0, xfonts-utils
