Architecture: all
Version: 0.93-1
Depends: perl (>= 5.6.0-16)
Filename: pool/main/libt/libtie-dxhash-perl/libtie-dxhash-perl_0.93-1_all.deb
Size: 10106
MD5sum: d50828114e7d339e3223dd3161a27e84
