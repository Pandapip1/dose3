Depends: libc6 (>= 2.7-1), libevent1 (>= 1.3e), libssl0.9.8 (>= 0.9.8f-5), zlib1g (>= 1:1.1.4), adduser, tsocks
Recommends: privoxy | polipo (>= 1), socat, logrotate, tor-geoipdb
Suggests: mixmaster, mixminion, anon-proxy
